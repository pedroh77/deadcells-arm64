diff --git a/src/module.c b/src/module.c
index 82b5119..4860db7 100644
--- a/src/module.c
+++ b/src/module.c
@@ -504,6 +504,22 @@ static void *resolve_library( const char *lib, bool is_opt ) {
 
 	strcpy(tmp,lib);
 
+#	ifndef HL_WIN
+	{
+		// deadcells-arm64: prefer .hdll located alongside libhl.dylib so x86_64 .hdll files in cwd don't collide
+		Dl_info dli;
+		if( dladdr((void*)resolve_library, &dli) && dli.dli_fname ) {
+			const char *slash = strrchr(dli.dli_fname, '/');
+			if( slash ) {
+				char fullpath[1024];
+				snprintf(fullpath, sizeof(fullpath), "%.*s/%s.hdll", (int)(slash - dli.dli_fname), dli.dli_fname, lib);
+				h = dlopen(fullpath, RTLD_LAZY);
+				if( h != NULL ) return h;
+			}
+		}
+	}
+#	endif
+
 #	ifdef HL_64
 	strcpy(tmp+strlen(lib),"64.hdll");
 	h = dlopen(tmp,RTLD_LAZY);
@@ -688,6 +704,15 @@ static void hl_module_init_natives( hl_module *m ) {
 		char *p = tmp;
 		void *f;
 		if( is_opt ) lib++;
+		if( getenv("HL_DUMP_NATIVES") ) {
+			// deadcells-arm64: dump required natives (lib name signature) for compatibility checks
+			p = tmp;
+			append_type(&p,n->t);
+			*p++ = 0;
+			printf("NATIVE %s %s %s\n", n->lib, n->name, tmp);
+			m->functions_ptrs[n->findex] = hl_prim_not_loaded;
+			continue;
+		}
 		if( curlib != lib ) {
 			curlib = lib;
 			libHandler = resolve_library(lib, is_opt);
@@ -696,6 +721,15 @@ static void hl_module_init_natives( hl_module *m ) {
 			m->functions_ptrs[n->findex] = disabled_primitive;
 			continue;
 		}
+		if( getenv("HL_DUMP_NATIVES") ) {
+			// deadcells-arm64: dump required natives (lib name signature) for compatibility checks
+			p = tmp;
+			append_type(&p,n->t);
+			*p++ = 0;
+			printf("NATIVE %s %s %s\n", n->lib, n->name, tmp);
+			m->functions_ptrs[n->findex] = hl_prim_not_loaded;
+			continue;
+		}
 		strcpy(p,"hlp_");
 		p += 4;
 		strcpy(p,n->name);
