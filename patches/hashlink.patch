diff --git a/libs/uv/uv.c b/libs/uv/uv.c
index e23a71c..9a6d7b3 100644
--- a/libs/uv/uv.c
+++ b/libs/uv/uv.c
@@ -350,3 +350,39 @@ DEFINE_PRIM(_I32, loop_alive_wrap, _LOOP);
 DEFINE_PRIM(_VOID, stop_wrap, _LOOP);
 
 DEFINE_PRIM(_BYTES, strerror, _I32);
+
+// ----- deadcells-arm64: Motion Twin's custom async DNS resolve (reconstructed from the shipped uv.hdll)
+// resolve(loop, host, unused, cb:(status, ipv4, ipv6) -> Void) : Bool
+
+static void on_resolve( uv_getaddrinfo_t *req, int status, struct addrinfo *res ) {
+	vclosure *c = (vclosure*)req->data;
+	int ip = 0;
+	vbyte *ip6 = NULL;
+	hl_remove_root(&req->data);
+	if( status == 0 && res ) {
+		if( res->ai_family == AF_INET )
+			ip = (int)((struct sockaddr_in*)res->ai_addr)->sin_addr.s_addr;
+		else if( res->ai_family == AF_INET6 )
+			ip6 = hl_copy_bytes((vbyte*)&((struct sockaddr_in6*)res->ai_addr)->sin6_addr, 16);
+	}
+	if( res ) uv_freeaddrinfo(res);
+	free(req);
+	if( c->hasValue )
+		((void(*)(void*,int,int,vbyte*))c->fun)(c->value, status, ip, ip6);
+	else
+		((void(*)(int,int,vbyte*))c->fun)(status, ip, ip6);
+}
+
+HL_PRIM bool HL_NAME(resolve)( uv_loop_t *loop, vbyte *host, int unused, vclosure *cb ) {
+	uv_getaddrinfo_t *req = (uv_getaddrinfo_t*)malloc(sizeof(uv_getaddrinfo_t));
+	int err;
+	req->data = cb;
+	hl_add_root(&req->data);
+	err = uv_getaddrinfo(loop, req, on_resolve, (char*)host, NULL, NULL);
+	if( err ) {
+		hl_remove_root(&req->data);
+		free(req);
+	}
+	return err == 0;
+}
+DEFINE_PRIM(_BOOL, resolve, _LOOP _BYTES _I32 _FUN(_VOID, _I32 _I32 _BYTES));
